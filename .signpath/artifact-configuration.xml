<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath の Artifact Configuration(SignPath の画面へ貼り付けて使う控え)。
  release.yml は actions/upload-artifact で Hashi.exe と HashiMCP-RustPreview.exe を1つの zip にして渡す。
  version は release.yml が rust/Cargo.toml の版(タグと照合済み)を渡す。
  WebView2Loader.dll は Microsoft 製の上流ライブラリなので署名対象にしない(zip へは未署名のまま同梱)。
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Hashi.exe" product-name="Hashi" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="HashiMCP-RustPreview.exe" product-name="Hashi" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
